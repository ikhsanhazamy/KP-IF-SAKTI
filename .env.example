# =============================================================================
# KONFIGURASI DOCKER & BACKEND (DEVELOPMENT / LOCAL)
# =============================================================================
# Salin berkas ini ke .env untuk deployment lokal / development:
# cp .env.example .env

# --- Konfigurasi Aplikasi ---
APP_NAME=KP-IF-SAKTI
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Konfigurasi Basis Data MySQL ---
MYSQL_ROOT_PASSWORD=root_password
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kp_db
DB_USERNAME=kp_user
DB_PASSWORD=kp_password

# --- Driver Layanan Laravel ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Webhook Integrasi Google Sheets / Apps Script (Opsional) ---
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_TOKEN=
