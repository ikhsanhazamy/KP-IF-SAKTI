# =============================================================================
# KONFIGURASI DOCKER & BACKEND (PRODUCTION VPS)
# =============================================================================
# Salin berkas ini ke .env di server VPS Anda sebelum menjalankan deploy:
# cp .env.production.example .env
# nano .env

# --- Konfigurasi Aplikasi Produksi ---
APP_NAME=KP-IF-SAKTI
APP_ENV=production
APP_DEBUG=false
# Ganti dengan domain resmi Anda (atau http://IP_VPS:8000 jika belum ada domain)
APP_URL=https://fatayat-sukabumi.org

# --- Keamanan Kredensial MySQL Server ---
# PERINGATAN: Gunakan kata sandi acak, panjang, dan kuat untuk server produksi!
MYSQL_ROOT_PASSWORD=GantiDenganRootPasswordKuatDanAcak_2026!
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kp_production_db
DB_USERNAME=kp_prod_user
DB_PASSWORD=GantiDenganPasswordUserKuatDanAcak_2026!

# --- Optimasi Driver Layanan Produksi ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Logging Produksi ---
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Webhook Integrasi Google Apps Script (Opsional) ---
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_TOKEN=
